# ==========================================
# BACKEND CONFIGURATIONS (FastAPI)
# ==========================================
# Local PostgreSQL Database connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/sih26003_dev

# Cryptographic secret key used for signing session tokens
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Application state setting (development, staging, production)
ENVIRONMENT=development

# Allowed cross-origin sources (points directly to your React dev server)
CORS_ORIGINS=http://localhost:5173


# ==========================================
# FRONTEND CONFIGURATIONS (React + Vite)
# ==========================================
# Base route URL pointing directly to your running FastAPI instance
VITE_API_BASE_URL=http://localhost:8000
